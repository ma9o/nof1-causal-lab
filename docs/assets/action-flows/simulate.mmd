---
config:
  theme: base
  themeVariables:
    fontFamily: Excalifont
  flowchart:
    wrappingWidth: 640
    padding: 18
    nodeSpacing: 44
    rankSpacing: 40
---
flowchart TD
    accTitle: simulate — generate dated histories from the current model
    accDescr: A model that cannot simulate, a start before the retained histories, a non-state intervention target or a diverging log-link mean fails the call. Otherwise 100 draws are generated from the resolved start state and checked; with interventions, a certified effect is summarized, and the report commits without changing the model.

    request(["simulate<br/>model_revision · end · start? · interventions"])
    error["Fails · nothing saved<br/>the model cannot execute or simulate<br/>start before the first retained state<br/>an intervention target is not a latent state<br/>a log-link mean diverges"]
    start["Resolve the start state<br/>retained joint state at or before start, advanced to it<br/>without retained histories: the initial-state law"]
    generate["Generate 100 draws · seed 0<br/>stochastic nonlinear dynamics + true emissions<br/>interventions add a paired reference history"]
    checks["Checks on this batch<br/>dynamics: C1a C1b C2 C3 C4c · emissions: C5c<br/>not evaluated: C4b edge contrasts · C5a C5b need observed data"]
    events{"Any<br/>interventions?"}
    certified{"Targets identified,<br/>a fitted revision,<br/>finite paths?"}
    effect["Summarize the effect on the outcome"]
    unavailable["No numeric effect<br/>record the reason"]
    commit(["Commit simulation report + arrays + logs<br/>the model revision is unchanged"])
    messages["Saved with messages<br/>warning: failed checks<br/>info: checks not evaluated · effect not reportable"]

    request -. fails .-> error
    request --> start --> generate --> checks --> events
    events -->|yes| certified
    events -->|no| commit
    certified -->|yes| effect --> commit
    certified -->|no| unavailable --> commit
    messages -.- commit

    classDef action fill:#6d28d9,stroke:#6d28d9,color:#ffffff
    classDef decision fill:#f1f5f9,stroke:#64748b,color:#0f172a
    classDef error fill:#fff1f2,stroke:#b91c1c,color:#7f1d1d
    classDef messages fill:#fffbeb,stroke:#b45309,color:#451a03
    classDef commit fill:#ecfdf5,stroke:#047857,color:#064e3b
    classDef check fill:#f8fafc,stroke:#334155,color:#0f172a
    class request action
    class events,certified decision
    class error error
    class messages messages
    class commit commit
    class checks check
