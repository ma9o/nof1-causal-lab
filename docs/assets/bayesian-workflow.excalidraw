    {
      "id": "title",
      "type": "text",
      "x": 90,
      "y": 50,
      "width": 1736.345703125,
      "height": 52.8,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
