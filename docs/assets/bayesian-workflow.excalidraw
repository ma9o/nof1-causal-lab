      "updated": 1790676414436,
      "link": null,
      "locked": false,
      "text": "Bayesian workflow (Gelman, Vehtari & McElreath 2026, Fig. 2.1) in nof1-causal-lab terms",
      "fontSize": 44,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bayesian workflow (Gelman, Vehtari & McElreath 2026, Fig. 2.1) in nof1-causal-lab terms",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 90,
      "y": 120,
      "width": 1888.525390625,
      "height": 48,
      "angle": 0,
      "strokeColor": "#52606d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b20",
      "roundness": null,
      "seed": 1714436528,
      "version": 2,
      "versionNonce": 126011728,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790676414436,
      "link": null,
      "locked": false,
      "text": "Six actions replace the book's “Choose your focus”. The four that commit turn the book's loop back to the start into one return lane each, in that action's shade; data_diff and model_diff only read, so they have none.\nA card's strip repeats the book's step; its body names the ModelSpec field, action, derivation or finding that carries it here. Checked against master on 2026-09-29.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Six actions replace the book's “Choose your focus”. The four that commit turn the book's loop back to the start into one return lane each, in that action's shade; data_diff and model_diff only read, so they have none.\nA card's strip repeats the book's step; its body names the ModelSpec field, action, derivation or finding that carries it here. Checked against master on 2026-09-29.",
      "autoResize": true,
      "lineHeight": 1.2
    },
