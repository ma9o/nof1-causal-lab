    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 90,
      "y": 120,
      "width": 1518.4765625,
      "height": 48,
      "angle": 0,
      "strokeColor": "#52606d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 555121241,
      "version": 2,
      "versionNonce": 1928444441,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790345286063,
      "link": null,
      "locked": false,
      "text": "Our four scientific actions replace the book's “Choose your focus”, and the book's loop back to the start becomes one return lane per action, in that action's shade.\nA card's strip repeats the book's step; its body names the ModelSpec field, action, derivation or finding that carries it here. Checked against the working tree on 2026-09-25.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our four scientific actions replace the book's “Choose your focus”, and the book's loop back to the start becomes one return lane per action, in that action's shade.\nA card's strip repeats the book's step; its body names the ModelSpec field, action, derivation or finding that carries it here. Checked against the working tree on 2026-09-25.",
      "autoResize": true,
      "lineHeight": 1.2
    },
