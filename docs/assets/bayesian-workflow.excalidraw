      "versionNonce": 882311671,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790345286063,
      "link": null,
      "locked": false,
      "text": "Small scale simulation tests · SBC. simulate output cannot become a\npanel for fit, so no model is refit on fake data, and fit's single\nEuler–Maruyama step per interval is never checked against simulate's\nDiffrax paths.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Small scale simulation tests · SBC. simulate output cannot become a\npanel for fit, so no model is refit on fake data, and fit's single\nEuler–Maruyama step per interval is never checked against simulate's\nDiffrax paths.",
      "autoResize": true,
      "lineHeight": 1.2
    },
