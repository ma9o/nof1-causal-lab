      "isDeleted": false,
      "boundElements": [],
      "updated": 1790702028616,
      "link": null,
      "locked": false,
      "text": "Small scale simulation tests · SBC. prepare_data turns a simulate\nreplicate into a panel for fit, but nothing summarises recovery or\nranks truths. Diffrax replicates also test fit's Euler–Maruyama\nsteps, so an SBC failure would mix sampler and discretization error.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Small scale simulation tests · SBC. prepare_data turns a simulate\nreplicate into a panel for fit, but nothing summarises recovery or\nranks truths. Diffrax replicates also test fit's Euler–Maruyama\nsteps, so an SBC failure would mix sampler and discretization error.",
      "autoResize": true,
      "lineHeight": 1.2
    },
