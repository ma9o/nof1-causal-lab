{
  "name": "nof1-causal-lab",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "storybook": "turbo storybook",
    "integration:start": "bash scripts/start_agentic_integration_stack.sh",

    "check": "bun run test:fixture-promotion && turbo run lint type-check test build codegen:check docs:check knip --continue=always",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "type-check": "turbo type-check",
    "test": "bun run test:fixture-promotion && turbo test",
    "test:all": "turbo test:all",
    "test:fixture-promotion": "bun test scripts/promote-data-to-fixture.test.ts",
    "knip": "knip --production",
    "duplicates": "bun run --cwd apps/data-pipeline duplicates",

    "codegen": "bun run --cwd packages/api-types codegen",
    "codegen:check": "bun run --cwd packages/api-types codegen:check",
    "types:graph": "bun run --cwd apps/data-pipeline types:graph",

    "docs:codegen": "bun run docs:distribution && bun run docs:latex",
    "docs:check": "bun run --parallel --no-exit-on-error docs:distribution:check docs:latex:check docs:markdown:check docs:spell:check",
    "docs:distribution": "bun run --cwd apps/data-pipeline docs:distribution",
    "docs:distribution:check": "bun run docs:distribution --check",
    "docs:latex": "bun scripts/codegen_docs_latex.js",
    "docs:latex:check": "bun run docs:latex --check",
    "docs:markdown:check": "markdownlint-cli2 --config .markdownlint-docs.json \"README.md\" \"docs/**/*.md\"",
    "docs:spell:check": "cspell --config cspell.config.json --no-progress --show-suggestions \"README.md\" \"docs/**/*.md\"",

    "fixture:promote": "bun scripts/promote-data-to-fixture.ts",
    "fixture:demo": "PYTHONHASHSEED=0 uv run --project apps/data-pipeline python apps/data-pipeline/scripts/generate_demo_fixture_completion.py",
    "fixture:demo:check": "bun run fixture:demo --check",

    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "cspell": "^10.0.0",
    "jscpd": "5.0.12",
    "knip": "^6.20.0",
    "markdownlint-cli2": "^0.22.0",
    "mathjax-full": "3.2.2",
    "turbo": "^2"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
