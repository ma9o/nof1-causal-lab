  "analysis": [
    {
      "name": "get_model_info",
      "description": "Return a read-only summary of the fitted model, variables with persistent IDs, identifiability status, and diagnostics.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "sections": {
            "description": "Named sections to include in the read-only model summary.",
            "items": {
              "enum": [
                "overview",
                "variables",
                "measurement",
                "identifiability",
                "diagnostics",
                "capabilities"
              ],
              "type": "string"
            },
            "title": "Sections",
            "type": "array"
          },
          "names": {
            "description": "Optional construct or indicator names to focus the summary on.",
            "items": {
              "type": "string"
            },
            "title": "Names",
            "type": "array"
          }
        },
        "title": "GetModelInfoInput",
        "type": "object"
      },
      "result": null
    },
    {
      "name": "simulate",
      "description": "Run a live nonlinear drift simulation across posterior draws, without future process noise. Start from the deterministic baseline equilibrium (interventional) or an abducted fitted latent state (counterfactual), apply one or more timed latent clamps (do-operators), and read the effect on an outcome over a horizon. Targets and outcome use persistent construct IDs. The result is ephemeral and includes its request, fitted model revision, and trajectory coordinates.",
      "parameters": {
        "additionalProperties": false,
        "description": "One reusable request for an on-demand simulation of a fitted model.",
        "properties": {
          "start": {
            "additionalProperties": false,
            "description": "Where the forward rollout begins (replaces the rung-2/rung-3 split).",
            "properties": {
              "kind": {
                "default": "baseline",
                "description": "'baseline' starts from the deterministic drift equilibrium (an interventional, rung-2 query). 'abducted' conditions on the individual's observed evidence and starts from the recovered fitted latent state (a counterfactual, rung-3 query).",
                "enum": [
                  "baseline",
                  "abducted"
                ],
                "title": "Kind",
                "type": "string"
              },
              "time_index": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Abducted start only: observed fitted-state index to begin from. Defaults to the final retained fitted latent state.",
                "title": "Time Index"
              },
              "time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Abducted start only: ISO-8601 observed timestamp matching a retained fitted latent state. Use either time_index or time, not both.",
                "title": "Time"
              }
            },
            "title": "ScenarioStartInput",
            "type": "object"
          },
          "clamps": {
            "description": "One or more timed latent clamps composing the scenario.",
            "items": {
              "additionalProperties": false,
              "description": "A do-operator on one latent variable over a time window.\n\nThe window is ``[from_day, to_day)`` in days relative to the rollout start; outside\nthe window the variable evolves under its natural dynamics. ``set`` pins to an absolute\nvalue, ``shift`` adds an amount to the variable's start-state value, ``ramp`` linearly\ninterpolates across the window, and ``trajectory`` tracks a list of values across it.",
              "properties": {
                "target": {
                  "pattern": "^construct:[A-Za-z0-9_.-]+$",
                  "tsType": "`construct:${string}`",
                  "type": "string"
                },
                "mode": {
                  "description": "How the clamped value is specified over the window.",
                  "enum": [
                    "set",
                    "shift",
                    "ramp",
                    "trajectory"
                  ],
                  "title": "Mode",
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Required when mode='set'. Absolute latent-space value.",
                  "title": "Value"
                },
                "amount": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Required when mode='shift'. Additive delta from the start-state value.",
                  "title": "Amount"
                },
                "value_start": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Required when mode='ramp'. Value at from_day.",
                  "title": "Value Start"
                },
                "value_end": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Required when mode='ramp'. Value at to_day.",
                  "title": "Value End"
                },
                "values": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Required when mode='trajectory'. Values sampled evenly across the window.",
                  "title": "Values"
                },
                "from_day": {
                  "default": 0.0,
                  "description": "Window onset in days from the rollout start.",
                  "minimum": 0.0,
                  "title": "From Day",
                  "type": "number"
                },
                "to_day": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Window end in days from the rollout start. Null runs through the horizon.",
                  "title": "To Day"
                }
              },
              "required": [
                "target",
                "mode"
              ],
              "title": "ScenarioClamp",
              "type": "object"
            },
            "minItems": 1,
            "title": "Clamps",
            "type": "array"
          },
          "outcome": {
            "pattern": "^construct:[A-Za-z0-9_.-]+$",
            "tsType": "`construct:${string}`",
            "type": "string"
          },
          "readout": {
            "additionalProperties": false,
            "properties": {
              "estimand": {
                "default": "trajectory",
                "description": "Report the final-horizon outcome effect or the full effect trajectory.",
                "enum": [
                  "end_state",
                  "trajectory"
                ],
                "title": "Estimand",
                "type": "string"
              },
              "horizon_days": {
                "default": 30,
                "description": "Forward horizon in days from the rollout start.",
                "maximum": 365,
                "minimum": 1,
                "title": "Horizon Days",
                "type": "integer"
              },
              "projection": {
                "default": "latent",
                "description": "Report latent outcome effects, manifest projections, or both.",
                "enum": [
                  "latent",
                  "manifest",
                  "both"
                ],
                "title": "Projection",
                "type": "string"
              }
            },
            "title": "ScenarioQueryInput",
            "type": "object"
          }
        },
        "required": [
          "clamps",
          "outcome"
        ],
        "title": "ScenarioRequest",
        "type": "object"
      },
      "result": {
        "anyOf": [
          {
            "additionalProperties": false,
            "description": "Ephemeral response to a runtime simulation request.\n\nThis engine integrates the true nonlinear drift for each posterior draw.\nIt does not include future process noise or claim the mean of the SDE.",
            "properties": {
              "request": {
                "additionalProperties": false,
                "description": "One reusable request for an on-demand simulation of a fitted model.",
                "properties": {
                  "start": {
                    "additionalProperties": false,
                    "description": "Where the forward rollout begins (replaces the rung-2/rung-3 split).",
                    "properties": {
                      "kind": {
                        "default": "baseline",
                        "description": "'baseline' starts from the deterministic drift equilibrium (an interventional, rung-2 query). 'abducted' conditions on the individual's observed evidence and starts from the recovered fitted latent state (a counterfactual, rung-3 query).",
                        "enum": [
                          "baseline",
                          "abducted"
                        ],
                        "title": "Kind",
                        "type": "string"
                      },
                      "time_index": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Abducted start only: observed fitted-state index to begin from. Defaults to the final retained fitted latent state.",
                        "title": "Time Index"
                      },
                      "time": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Abducted start only: ISO-8601 observed timestamp matching a retained fitted latent state. Use either time_index or time, not both.",
                        "title": "Time"
                      }
                    },
                    "title": "ScenarioStartInput",
                    "type": "object"
                  },
                  "clamps": {
                    "description": "One or more timed latent clamps composing the scenario.",
                    "items": {
                      "additionalProperties": false,
                      "description": "A do-operator on one latent variable over a time window.\n\nThe window is ``[from_day, to_day)`` in days relative to the rollout start; outside\nthe window the variable evolves under its natural dynamics. ``set`` pins to an absolute\nvalue, ``shift`` adds an amount to the variable's start-state value, ``ramp`` linearly\ninterpolates across the window, and ``trajectory`` tracks a list of values across it.",
                      "properties": {
                        "target": {
                          "pattern": "^construct:[A-Za-z0-9_.-]+$",
                          "tsType": "`construct:${string}`",
                          "type": "string"
                        },
                        "mode": {
                          "description": "How the clamped value is specified over the window.",
                          "enum": [
                            "set",
                            "shift",
                            "ramp",
                            "trajectory"
                          ],
                          "title": "Mode",
                          "type": "string"
                        },
                        "value": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null,
                          "description": "Required when mode='set'. Absolute latent-space value.",
                          "title": "Value"
                        },
                        "amount": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null,
                          "description": "Required when mode='shift'. Additive delta from the start-state value.",
                          "title": "Amount"
                        },
                        "value_start": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null,
                          "description": "Required when mode='ramp'. Value at from_day.",
                          "title": "Value Start"
                        },
                        "value_end": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null,
                          "description": "Required when mode='ramp'. Value at to_day.",
                          "title": "Value End"
                        },
                        "values": {
                          "anyOf": [
                            {
                              "items": {
                                "type": "number"
                              },
                              "type": "array"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null,
                          "description": "Required when mode='trajectory'. Values sampled evenly across the window.",
                          "title": "Values"
                        },
                        "from_day": {
                          "default": 0.0,
                          "description": "Window onset in days from the rollout start.",
                          "minimum": 0.0,
                          "title": "From Day",
                          "type": "number"
                        },
                        "to_day": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null,
                          "description": "Window end in days from the rollout start. Null runs through the horizon.",
                          "title": "To Day"
                        }
                      },
                      "required": [
                        "target",
                        "mode"
                      ],
                      "title": "ScenarioClamp",
                      "type": "object"
                    },
                    "minItems": 1,
                    "title": "Clamps",
                    "type": "array"
                  },
                  "outcome": {
                    "pattern": "^construct:[A-Za-z0-9_.-]+$",
                    "tsType": "`construct:${string}`",
                    "type": "string"
                  },
                  "readout": {
                    "additionalProperties": false,
                    "properties": {
                      "estimand": {
                        "default": "trajectory",
                        "description": "Report the final-horizon outcome effect or the full effect trajectory.",
                        "enum": [
                          "end_state",
                          "trajectory"
                        ],
                        "title": "Estimand",
                        "type": "string"
                      },
                      "horizon_days": {
                        "default": 30,
                        "description": "Forward horizon in days from the rollout start.",
                        "maximum": 365,
                        "minimum": 1,
                        "title": "Horizon Days",
                        "type": "integer"
                      },
                      "projection": {
                        "default": "latent",
                        "description": "Report latent outcome effects, manifest projections, or both.",
                        "enum": [
                          "latent",
                          "manifest",
                          "both"
                        ],
                        "title": "Projection",
                        "type": "string"
                      }
                    },
                    "title": "ScenarioQueryInput",
                    "type": "object"
                  }
                },
                "required": [
                  "clamps",
                  "outcome"
                ],
                "title": "ScenarioRequest",
                "type": "object"
              },
              "model": {
                "additionalProperties": false,
                "description": "The workspace and version of the scientific design supporting an inference.",
                "properties": {
                  "workspace_id": {
                    "minLength": 1,
                    "title": "Workspace Id",
                    "type": "string"
                  },
                  "version": {
                    "minimum": 1,
                    "title": "Version",
                    "type": "integer"
                  }
                },
                "required": [
                  "workspace_id",
                  "version"
                ],
                "title": "ModelRevision",
                "type": "object"
              },
              "time_grid_days": {
                "description": "Shared elapsed-day coordinates for all trajectories, including day zero.",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "title": "Time Grid Days",
                "type": "array"
              },
              "start_time_index": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Resolved fitted-state index for an abducted start; null for a baseline start.",
                "title": "Start Time Index"
              },
              "start_time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Observed timestamp of the resolved abducted start, when available.",
                "title": "Start Time"
              },
              "labels": {
                "additionalProperties": {
                  "type": "string"
                },
                "propertyNames": {
                  "pattern": "^construct:[A-Za-z0-9_.-]+$",
                  "tsType": "`construct:${string}`",
                  "type": "string"
                },
                "title": "Labels",
                "type": "object"
              },
              "summary": {
                "additionalProperties": false,
                "description": "An effect summary reports posterior location, uncertainty, and sign probability.",
                "properties": {
                  "mean": {
                    "title": "Mean",
                    "type": "number"
                  },
                  "median": {
                    "title": "Median",
                    "type": "number"
                  },
                  "lower_95": {
                    "title": "Lower 95",
                    "type": "number"
                  },
                  "upper_95": {
                    "title": "Upper 95",
                    "type": "number"
                  },
                  "prob_positive": {
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Prob Positive",
                    "type": "number"
                  }
                },
                "required": [
                  "mean",
                  "median",
                  "lower_95",
                  "upper_95",
                  "prob_positive"
                ],
                "title": "EffectSummary",
                "type": "object"
              },
              "effect_trajectory": {
                "anyOf": [
                  {
                    "items": {
                      "additionalProperties": false,
                      "description": "An effect trajectory point records a causal delta at one elapsed rollout time.",
                      "properties": {
                        "day": {
                          "minimum": 0,
                          "title": "Day",
                          "type": "number"
                        },
                        "effect": {
                          "title": "Effect",
                          "type": "number"
                        }
                      },
                      "required": [
                        "day",
                        "effect"
                      ],
                      "title": "EffectTrajectoryPoint",
                      "type": "object"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Effect Trajectory"
              },
              "trajectory_peak": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "description": "An effect trajectory point records a causal delta at one elapsed rollout time.",
                    "properties": {
                      "day": {
                        "minimum": 0,
                        "title": "Day",
                        "type": "number"
                      },
                      "effect": {
                        "title": "Effect",
                        "type": "number"
                      }
                    },
                    "required": [
                      "day",
                      "effect"
                    ],
                    "title": "EffectTrajectoryPoint",
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "trajectories": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "description": "One construct's mean reference and intervention paths across simulated draws.",
                  "properties": {
                    "reference_mean": {
                      "description": "Mean no-clamp latent path on the result's time_grid_days, including day zero.",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "title": "Reference Mean",
                      "type": "array"
                    },
                    "action_mean": {
                      "description": "Mean latent path under the requested clamps on the same full time grid.",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "title": "Action Mean",
                      "type": "array"
                    }
                  },
                  "required": [
                    "reference_mean",
                    "action_mean"
                  ],
                  "title": "SimulationTrajectory",
                  "type": "object"
                },
                "description": "Reference and action means for each simulated construct on time_grid_days.",
                "propertyNames": {
                  "pattern": "^construct:[A-Za-z0-9_.-]+$",
                  "tsType": "`construct:${string}`",
                  "type": "string"
                },
                "title": "Trajectories",
                "type": "object"
              },
              "manifest_effects": {
                "anyOf": [
                  {
                    "additionalProperties": {
                      "type": "number"
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Manifest Effects"
              },
              "reference_mean": {
                "title": "Reference Mean",
                "type": "number"
              },
              "warnings": {
                "items": {
                  "type": "string"
                },
                "title": "Warnings",
                "type": "array"
              }
            },
            "required": [
              "request",
              "model",
              "time_grid_days",
              "labels",
              "summary",
              "trajectories",
              "reference_mean"
            ],
            "title": "SimulationResult",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "error": {
                "title": "Error",
                "type": "string"
              },
              "identifiable_treatments": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Identifiable Treatments"
              }
            },
            "required": [
              "error"
            ],
            "title": "ToolError",
            "type": "object"
          }
        ],
        "title": "SimulateScenarioToolResult"
      }
    }
  ],
  "_interactive": [
