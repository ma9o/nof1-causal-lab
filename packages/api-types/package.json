{
  "name": "@nof1-causal-lab/api-types",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error codegen:check lint type-check",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",

    "codegen": "bun run codegen:schemas && bun run --parallel --no-exit-on-error codegen:types codegen:client",
    "codegen:check": "bun run --parallel --no-exit-on-error codegen:schemas:check codegen:types:check codegen:client:check",
    "codegen:schemas": "uv run --directory ../../apps/data-pipeline python -m scripts.codegen.export_api",
    "codegen:schemas:check": "bun run codegen:schemas --check",
    "codegen:types": "bun run scripts/generate.ts",
    "codegen:types:check": "bun run codegen:types --check",
    "codegen:client": "bun run scripts/generate-client.ts",
    "codegen:client:check": "bun run codegen:client --check"
  },
  "devDependencies": {
    "@nof1-causal-lab/typescript-config": "workspace:*",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  },
  "dependencies": {
    "openapi-fetch": "0.16.0"
  }
}
