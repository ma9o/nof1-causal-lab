{
  "name": "@nof1-causal-lab/api-types",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error codegen:check lint type-check",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",

    "codegen": "bun run --parallel --no-exit-on-error codegen:contracts codegen:agent-api && bun run codegen:client",
    "codegen:check": "bun run --parallel --no-exit-on-error codegen:contracts:json:check codegen:contracts:typescript:check codegen:agent-api:check codegen:client:check",
    "codegen:contracts": "bun run codegen:contracts:json && bun run codegen:contracts:typescript",
    "codegen:contracts:json": "uv run --directory ../../apps/data-pipeline python -m scripts.export_schemas",
    "codegen:contracts:json:check": "bun run codegen:contracts:json --check",
    "codegen:contracts:typescript": "bun run scripts/generate.ts",
    "codegen:contracts:typescript:check": "bun run codegen:contracts:typescript --check",
    "codegen:agent-api": "uv run --directory ../../apps/data-pipeline python scripts/export_agent_api.py",
    "codegen:agent-api:check": "bun run codegen:agent-api --check",
    "codegen:client": "bun run scripts/generate-client.ts",
    "codegen:client:check": "bun run codegen:client --check"
  },
  "devDependencies": {
    "@nof1-causal-lab/typescript-config": "workspace:*",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  },
  "dependencies": {
    "openapi-fetch": "0.16.0"
  }
}
